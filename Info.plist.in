<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleExecutable</key>
  <string>@MACOS_APP_NAME@</string>

  <key>CFBundleDisplayName</key>
  <string>@readstudio_DESCRIPTION@</string>

  <key>CFBundleSpokenName</key>
  <string>@readstudio_DESCRIPTION@</string>

  <key>CFBundleIconFile</key>
  <string>app-logo.icns</string>

  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>@readstudio_DESCRIPTION@ Project</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>@PROGRAM_RDNS_IDENTIFIER@.rsp</string>
      </array>
      <key>CFBundleTypeIconFile</key>
      <string>app-logo.icns</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
    </dict>

    <dict>
      <key>CFBundleTypeName</key>
      <string>@readstudio_DESCRIPTION@ Batch Project</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>@PROGRAM_RDNS_IDENTIFIER@.rsbp</string>
      </array>
      <key>CFBundleTypeIconFile</key>
      <string>app-logo.icns</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
    </dict>
  </array>

  <key>UTExportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>@PROGRAM_RDNS_IDENTIFIER@.rsp</string>
      <key>UTTypeDescription</key>
      <string>@readstudio_DESCRIPTION@ Project</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>com.pkware.zip-archive</string>
        <string>public.data</string>
      </array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array><string>rsp</string></array>
        <key>public.mime-type</key>
        <array><string>application/zip</string></array>
      </dict>
    </dict>

    <dict>
      <key>UTTypeIdentifier</key>
      <string>@PROGRAM_RDNS_IDENTIFIER@.rsbp</string>
      <key>UTTypeDescription</key>
      <string>@readstudio_DESCRIPTION@ Batch Project</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>com.pkware.zip-archive</string>
        <string>public.data</string>
      </array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array><string>rsbp</string></array>
        <key>public.mime-type</key>
        <array><string>application/zip</string></array>
      </dict>
    </dict>
  </array>

  <key>LSApplicationCategoryType</key>
  <string>public.app-category.productivity</string>

  <key>CFBundleIdentifier</key>
  <string>@PROGRAM_RDNS_IDENTIFIER@</string>

  <key>CFBundleName</key>
  <string>@readstudio_DESCRIPTION@</string>

  <key>CFBundlePackageType</key>
  <string>APPL</string>

  <key>CFBundleShortVersionString</key>
  <string>@readstudio_VERSION_MAJOR@.@readstudio_VERSION_MINOR@.@readstudio_VERSION_PATCH@</string>

  <key>CFBundleVersion</key>
  <string>@readstudio_VERSION_MAJOR@@readstudio_VERSION_MINOR@@readstudio_VERSION_PATCH@@readstudio_VERSION_TWEAK@</string>

  <key>NSHumanReadableCopyright</key>
  <string>Copyright 2006-@BUILD_YEAR@ @PUBLISHER@</string>

  <key>NSPrincipalClass</key>
  <string>wxNSApplication</string>

  <key>LSMinimumSystemVersion</key>
  <string>@CMAKE_OSX_DEPLOYMENT_TARGET@</string>
</dict>
</plist>
