msgid "Crop & center"
msgstr "Recortar y centrar"

#: ui/dialogs/tools_options_dlg.cpp:5637
msgid "Shrink to fit"
msgstr "Encogerse para adaptarse"

#: ui/dialogs/tools_options_dlg.cpp:5643
