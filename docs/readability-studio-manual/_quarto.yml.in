project:
  type: book
toc: true
toc-depth: 2
links-as-notes: true
linestretch: 1.15
biblio-title: References
biblio-style: mla
biblatexoptions: maxbibnames=4
link-citations: true
nocite: '@*'
csl: modern-language-association.csl
number-sections: true
metadata:
  pdf-cover: "images/non-generated/cover.png"
  pdf-cover-font-color: "255, 255, 255"
  pdf-cover-author-color: "61, 60, 59"
  pdf-cover-background-color: "250, 244, 230"
  pdf-logo: "images/non-generated/cover-logo.png"
  authorbio: >-
    \textsc{${PROGRAM_AUTHOR}} is the Director of Institutional Research at Edison State Community College.
    He earned a Bachelor of Arts in English from the University of Dayton and has researched readability formulas for more than twenty years.
    Before entering academia, he spent eighteen years working in the statistical software industry, primarily in localization engineering.
  trademark: "${PROGRAM_LONGNAME}"
  publisher: ${PUBLISHER}
  publisher-cities:
    - Brussels
    - Ottawa
    - Darmstadt
  # Legrand Orange Book uses this and implicitly adds "images/" to the path
  chapter-image: "non-generated/banner.jpg"
  theme-color: "44, 28, 216"
  page-side-decoration-color: "240, 108, 2"
  watermark: "${DOCS_WATERMARK}"
crossref:
  chapters: true
  sec-prefix: sec.
  tbl-prefix: tbl.
  fig-prefix: fig.
filters:
  - include-code-files
  - fontawesome
  - elevator
  - fancy-text
book:
  title: "${readstudio_DESCRIPTION} ${FULL_DISPLAY_VERSION}"
  subtitle: User Manual
  description: "${PROGRAM_COMMENTS}"
  author: ${PROGRAM_AUTHOR}
  date: today
  date-format: "YYYY"
  output-file: "readability-studio-manual"
  language: en
  search: false
format:
  pdf:
    documentclass: LegrandOrangeBook
    template: latex/default.tex
    include-in-header: latex/preamble.tex
    csquotes: true
    latex-engine: xelatex
    keep-tex: true
    citation-package: biblatex
    cite-method: biblatex
    lot: true
    lof: true
    code-block-bg: false
    CJKmainfont: NotoSerifJP
    CJKoptions:
      - Path=./fonts/NotoSerifJP/
      - Extension=.ttf
      - UprightFont=*-VariableFontwght
    mainfont: Inter
    mainfontoptions:
      - Path=./fonts/Inter/
      - Extension=.ttf
      - UprightFont=Inter-VariableFontopszwghtt
      - ItalicFont=Inter-ItalicVariableFontopszwght
    monofont: Inconsolata
    monofontoptions:
      - Path=./fonts/Inconsolata/
      - Extension=.ttf
      - UprightFont=Inconsolata-VariableFontwdthwght
      - ItalicFont=Inconsolata-VariableFontwdthwght
    linkcolor: black
    citecolor: black
  html:
    theme:
      light: flatly
      dark: darkly
    html-math-method: katex
    css: css/style.css
    smooth-scroll: true
    respect-user-color-scheme: true
